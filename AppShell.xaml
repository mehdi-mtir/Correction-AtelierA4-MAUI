<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GestionCommandes.Maui.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GestionCommandes.Maui.Views"
       Shell.FlyoutBehavior="Disabled"
       Title="GestionCommandes">

    <!-- 1. Page de connexion, HORS des onglets : c'est la première affichée -->
    <ShellContent Title="Connexion"
                  Route="connexion"
                  ContentTemplate="{DataTemplate views:ConnexionPage}" />

    <!-- 2. L'application elle-même : deux onglets -->
    <TabBar Route="principal">
        <ShellContent Title="Clients"
                      Route="clients"
                      ContentTemplate="{DataTemplate views:ClientsPage}" />
        <ShellContent Title="Commandes"
                      Route="commandes"
                      ContentTemplate="{DataTemplate views:CommandesPage}" />
    </TabBar>
</Shell>
