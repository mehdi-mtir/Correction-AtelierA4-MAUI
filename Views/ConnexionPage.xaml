<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionCommandes.Maui.ViewModels"
             x:Class="GestionCommandes.Maui.Views.ConnexionPage"
             x:DataType="vm:ConnexionViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource GcFond}">

    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center"
                         WidthRequest="{OnIdiom Desktop=400, Default=-1}">

        <Label Text="GestionCommandes" FontSize="28" FontAttributes="Bold"
               HorizontalOptions="Center" TextColor="{StaticResource GcPrimaire}" />
        <Label Text="Connectez-vous pour continuer" HorizontalOptions="Center"
               TextColor="{StaticResource GcTexteSecondaire}" />

        <Entry Placeholder="Identifiant" Text="{Binding Identifiant}" />
        <Entry Placeholder="Mot de passe" IsPassword="True"
               Text="{Binding MotDePasse}" />

        <Button Text="Se connecter" Style="{StaticResource PrimaryButton}"
                Command="{Binding SeConnecterCommand}" />

        <Label Text="{Binding Erreur}" TextColor="#C62828"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
